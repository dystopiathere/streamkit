#cloud-config
# Первичная настройка ВМ медиасервера. Compose-файл, конфиг LiveKit и
# сертификат для TURN привозит и обновляет выкатка (deploy.yml).

users:
  # Не «admin»: см. cloud-init/app.yaml.tftpl.
  - name: ops
    groups: sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${admin_ssh_public_key}
  - name: deploy
    shell: /bin/bash
    ssh_authorized_keys:
      - ${deploy_ssh_public_key}

package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - jq
  - curl

write_files:
  # Буфер приёма UDP по умолчанию мал для медиа: при нескольких гостях пакеты
  # отбрасываются ядром до LiveKit, и в эфире это слышно как рваный звук. Сам
  # LiveKit предупреждает об этом в логе при старте.
  - path: /etc/sysctl.d/99-livekit.conf
    permissions: "0644"
    content: |
      net.core.rmem_max=5000000
      net.core.wmem_max=5000000
  - path: /opt/livekit/infra.env
    permissions: "0644"
    content: |
%{ for key, value in infra_env ~}
      ${key}=${value}
%{ endfor ~}

runcmd:
  - sysctl --system
  - usermod -aG docker deploy
  - chown -R deploy:deploy /opt/livekit
  - systemctl enable --now docker
