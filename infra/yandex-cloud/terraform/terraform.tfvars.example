# Скопируйте в terraform.tfvars (он в .gitignore) и заполните.
# Секретов здесь нет: пароли и ключи Terraform генерирует сам и кладёт в Lockbox.

cloud_id   = "b1g..."
folder_id  = "b1g..."
acme_email = "admin@stream-kit.ru"

# Ваш адрес — чтобы заходить по SSH. Пусто — SSH только для выкатки по ключу.
admin_ssh_cidrs = ["203.0.113.10/32"]

admin_ssh_public_key  = "ssh-ed25519 AAAA... admin"
deploy_ssh_public_key = "ssh-ed25519 AAAA... github-actions-deploy"

# TXT в корне домена (README, раздел 3): подтверждение для Google Search Console
# (без него Google не публикует OAuth-приложение YouTube) и Яндекс 360, и SPF —
# одной записью v=spf1 на весь домен.
# root_txt_records = [
#   "google-site-verification=...",
#   "yandex-verification: ...",
#   "v=spf1 redirect=_spf.yandex.net",
# ]

# Запись DKIM из консоли Postbox (README, раздел «Почта»). До её появления — не задавать.
# postbox_dkim = {
#   name  = "postbox._domainkey.stream-kit.ru"
#   value = "v=DKIM1; k=rsa; p=MIIBIjANBg..."
# }

# Запись DKIM из панели Яндекс 360 (README, раздел «Почта на домене»).
# yandex_dkim = {
#   name  = "mail._domainkey.stream-kit.ru"
#   value = "v=DKIM1; k=rsa; t=s; p=MIGfMA0..."
# }

# DMARC (README, раздел «Почта на домене»). Ящик для отчётов должен существовать
# в Яндекс 360 — отчёты на несуществующий адрес просто теряются.
# dmarc = "v=DMARC1; p=none; rua=mailto:dmarc@stream-kit.ru"

# Размеры — README, раздел «Стоимость и рост». Не задано — значения по умолчанию
# из variables.tf (Valkey на burstable, ВМ с долей vCPU 50 %).
# valkey     = { resource_preset_id = "hm3-c2-m8", disk_gb = 16, version = "8.1-valkey" }
# app_vm     = { cores = 2, memory_gb = 4, disk_gb = 30, core_fraction = 100 }

# Сколько последних выпусков хранить в реестре. null — до первого выпуска.
# registry_cleanup = 15
