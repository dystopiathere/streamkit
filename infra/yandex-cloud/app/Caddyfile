# TLS и маршрутизация по доменам. Сертификаты Let's Encrypt Caddy выпускает и
# продлевает сам — по HTTP на 80-м порту, поэтому он открыт в группе безопасности.
{
	email {$ACME_EMAIL}

	# Медленные клиенты. Без срока на заголовки соединение, которое шлёт их по
	# байту в минуту, держится вечно, и тысяча таких занимает сервер без
	# единого запроса (slowloris). Срок на тело не ставим: он же оборвал бы
	# WebSocket сокетов и чата. Долгое тело упирается в таймаут Node в API.
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

(common) {
	encode zstd gzip
	# HSTS — здесь, а не в nginx образов: TLS заканчивается на Caddy, и только он
	# знает, что соединение защищено.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
	# Самые большие тела — JSON настроек виджета, и API сам не примет больше
	# 100 КБ. Потолок здесь отсекает гигабайтное тело до того, как Caddy
	# начнёт передавать его в контейнер.
	request_body {
		max_size 1MB
	}
}

# Главная, публичные страницы и дашборд. Заголовки безопасности (CSP и прочие)
# ставит nginx внутри образа — Caddy их не трогает.
{$DOMAIN} {
	import common

	# Статистика посещений: с основного домена отдаются ровно две вещи — скрипт
	# счётчика и приём событий. Не весь Umami по префиксу: иначе его вход и API
	# были бы доступны в обход пароля stats.<домен>. Свой origin — CSP страницы
	# менять не нужно, а блокировщики режут сторонние счётчики чаще.
	@site_stats path /u/script.js /u/api/send
	handle @site_stats {
		uri strip_prefix /u
		reverse_proxy umami:3000
	}

	handle {
		reverse_proxy web:80
	}
}

# Интерфейс Umami. Пароль Caddy — раньше формы входа Umami, у которой после
# установки пароль по умолчанию.
#
# Одного basic_auth мало: интерфейс Umami шлёт каждый запрос к своему API с
# собственным «Authorization: Bearer …», и этот заголовок вытесняет пароль,
# который браузер подставил бы сам. Caddy отвечал 401, браузер снова спрашивал
# пароль — по кругу. Поэтому пароль проверяется один раз, а дальше пропуском
# служит httpOnly-cookie с производным от него значением (deploy.sh).
stats.{$DOMAIN} {
	import common

	# Пустое значение не должно совпадать с отсутствующей cookie.
	@pass expression `{cookie.stats_gate} != "" && {cookie.stats_gate} == "{$STATS_GATE_TOKEN}"`
	handle @pass {
		# Продление пропуска, пока интерфейсом пользуются.
		header +Set-Cookie "stats_gate={$STATS_GATE_TOKEN}; Path=/; Max-Age=604800; Secure; HttpOnly; SameSite=Strict"
		reverse_proxy umami:3000
	}

	handle {
		# route — чтобы порядок был ровно записанным: cookie выдаётся только
		# после проверенного пароля. Без route Caddy ставит header раньше
		# basic_auth, и пропуск уходил бы вместе с ответом 401.
		route {
			basic_auth {
				owner {$STATS_BASIC_HASH}
			}
			header +Set-Cookie "stats_gate={$STATS_GATE_TOKEN}; Path=/; Max-Age=604800; Secure; HttpOnly; SameSite=Strict"
			# Пароль Caddy — не токен Umami: дальше он не уходит.
			request_header -Authorization
			reverse_proxy umami:3000
		}
	}
}

# Административная панель. Схема та же, что у stats: пароль один раз, дальше
# пропуск — cookie. Отличие одно: cookie ставится на весь домен, потому что
# проверяет её и блок api ниже — админское API без пропуска снаружи не видно.
# Вход сотрудника (пароль и код) — поверх, в самом API.
#
# Своего Authorization статика админки не шлёт, так что окно пароля по кругу,
# как у Umami, здесь не возникает; route — ради порядка cookie после пароля.
admin.{$DOMAIN} {
	import common

	@admin_pass expression `{cookie.admin_gate} != "" && {cookie.admin_gate} == "{$ADMIN_GATE_TOKEN}"`
	handle @admin_pass {
		header +Set-Cookie "admin_gate={$ADMIN_GATE_TOKEN}; Domain={$DOMAIN}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Strict"
		reverse_proxy admin:80
	}

	handle {
		route {
			basic_auth {
				owner {$ADMIN_BASIC_HASH}
			}
			header +Set-Cookie "admin_gate={$ADMIN_GATE_TOKEN}; Domain={$DOMAIN}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Strict"
			reverse_proxy admin:80
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

overlay.{$DOMAIN} {
	import common
	reverse_proxy overlay:80
}

# API и Socket.IO. WebSocket Caddy проксирует сам. API за одним прокси, и
# `trust proxy 1` в main.ts берёт адрес клиента из X-Forwarded-For — лимиты
# запросов считаются по посетителю, а не по Caddy.
api.{$DOMAIN} {
	import common
	# Вебхук LiveKit снаружи не нужен: медиасервер шлёт его на внутренний адрес
	# API (livekit/deploy.sh). Открытым он был ручкой без лимита запросов, где
	# каждая поддельная подпись — строка в журнале аудита: таблицу можно было
	# раздувать бесконечно с любого адреса.
	respond /api/livekit/webhook 404

	# Админское API — только с пропуском admin.<домен>. Без него 404, как
	# будто ручек нет: перебирать пароли сотрудников снаружи не на чем.
	# Предварительный запрос CORS cookie не несёт по правилам браузера, поэтому
	# OPTIONS пропускается — он ничего не делает, кроме ответа заголовками.
	@admin_api_closed {
		path /api/admin/*
		not method OPTIONS
		not expression `{cookie.admin_gate} != "" && {cookie.admin_gate} == "{$ADMIN_GATE_TOKEN}"`
	}
	respond @admin_api_closed 404

	reverse_proxy api:3000
}

# Сигнализация LiveKit по wss://. Браузер на https-странице не подключится к ws://,
# а сам LiveKit TLS не держит — его порт 7880 открыт только внутри сети.
rtc.{$DOMAIN} {
	import common
	reverse_proxy {$LIVEKIT_PRIVATE_IP}:7880
}
