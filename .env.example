# Скопируйте в .env в КОРНЕ репозитория и заполните. Файл в git не попадает
# (см. .gitignore). Второй копии в apps/api заводить не нужно: её читали CLI
# Prisma и приложение, и две копии одних секретов неизбежно расходились.
#
# Секреты генерируются так:
#   JWT_SECRET      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   ENCRYPTION_KEY  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   IP_HASH_PEPPER  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#   TOKEN_HASH_PEPPER  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# ВАЖНО: ENCRYPTION_KEY нельзя менять после первого запуска — им зашифрованы
# OAuth-токены площадок и TOTP-секреты в базе. Смена ключа делает их нечитаемыми.
#
# То же про TOKEN_HASH_PEPPER: им хэшируются refresh-токены и токены оверлеев.
# Смена этого значения разлогинивает всех и обрывает все ссылки для OBS —
# восстановить их нельзя, в базе лежат только хэши. Зато ключи независимы:
# перешифровать секреты можно, не трогая живые сессии, и наоборот.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Хранилища -------------------------------------------------------------
# Хост указан как 127.0.0.1, а не localhost: движок Prisma на Windows резолвит
# localhost в ::1 и не подключается к контейнеру, опубликованному на IPv4.
DATABASE_URL=postgresql://streamkit:streamkit@127.0.0.1:5432/streamkit?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- Секреты ---------------------------------------------------------------
JWT_SECRET=замените-на-случайное-значение-не-короче-32-символов
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=замените-на-32-байта-в-base64
IP_HASH_PEPPER=замените-на-случайное-значение
TOKEN_HASH_PEPPER=замените-на-случайное-значение

# --- Сеть ------------------------------------------------------------------
# Разрешённые Origin через запятую. В проде — только реальные домены.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Домен cookie. На localhost оставить пустым.
COOKIE_DOMAIN=
# Базовый URL overlay-приложения: из него собираются ссылки для OBS.
OVERLAY_BASE_URL=http://localhost:5174

# --- Площадки (аналитика) --------------------------------------------------
# Без client id и secret площадка не предлагается к подключению — приложение
# при этом стартует нормально.
#
# Адрес возврата обязан совпадать с зарегистрированным ПОСИМВОЛЬНО — вместе со
# схемой, портом и отсутствием слэша на конце. Для значений ниже это:
#
# Twitch: https://dev.twitch.tv/console/apps
#   http://localhost:3000/api/integrations/twitch/callback
#   Client Type: Confidential. Для регистрации приложения на аккаунте Twitch
#   обязательно включена двухфакторная аутентификация.
# YouTube: https://console.cloud.google.com/apis/credentials
#   http://localhost:3000/api/integrations/youtube/callback
#   Тип «Веб-приложение». Нужен включённый YouTube Data API v3.
#   Пока приложение в статусе Testing, Google выдаёт refresh-токен на 7 суток:
#   для постоянного сбора метрик приложение придётся опубликовать.
WEB_BASE_URL=http://localhost:5173
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Суточный лимит Google — 10 000 единиц на ПРОЕКТ, а не на пользователя.
# Остаток нужен на подключение новых каналов и ручные проверки.
YOUTUBE_DAILY_QUOTA=9000

# Чат Twitch читается АНОНИМНО: ни ключа, ни секрета, ни подключённой площадки
# для него не нужно — достаточно логина канала в настройках виджета. Переменная
# ниже переопределяет адрес IRC-шлюза и нужна только тестам; в боевом окружении
# её оставляют пустой.
TWITCH_IRC_URL=

# --- Приватные комнаты (LiveKit) ------------------------------------------
# Значения ниже — встроенные ключи режима `livekit-server --dev` из
# compose.dev.yml. Это не секреты: они опубликованы в документации LiveKit и
# годятся только для локальной разработки. В боевом окружении ключ и секрет
# свои, а адреса разные: LIVEKIT_URL — внутренний для API, LIVEKIT_PUBLIC_URL —
# wss:// для браузеров.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Для compose.yml (без --dev) секрет обязан быть не короче 32 символов, иначе
# LiveKit не стартует. Там же нужен публичный IP сервера для медиа:
# LIVEKIT_NODE_IP=

# --- Оплата подписки (ЮKassa) ---------------------------------------------
# Без магазина оплата не настроена, и приватные комнаты бесплатны — так в
# разработке. Тестовый магазин ЮKassa заводится без договора. Уведомления
# магазина направляются на https://<api>/api/billing/yookassa/webhook.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Кто формирует чек. none — самозанятый: чек выдаётся в «Мой налог», объект
# receipt ЮKassa не передаётся. fiscal — ИП или организация с «Чеками от ЮKassa».
YOOKASSA_RECEIPTS=none
# Только для fiscal: ставка НДС (1 — без НДС) и система налогообложения.
# Выбирает бухгалтер, не разработчик.
YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM_CODE=

# --- Реквизиты продавца -----------------------------------------------------
# На главной, в подвале и в документах. ЮKassa проверяет их на сайте до
# подключения оплаты. Персональные данные владельца — только здесь, не в коде.
SELLER_NAME=
# 12 цифр у физического лица (самозанятого), 10 — у организации.
SELLER_INN=
SELLER_EMAIL=
# SELLER_PHONE=

# --- Лимиты ----------------------------------------------------------------
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# --- Docker (compose) ------------------------------------------------------
POSTGRES_USER=streamkit
POSTGRES_PASSWORD=streamkit
POSTGRES_DB=streamkit

# --- Фронтенд (значения вшиваются в бандл на этапе сборки) ------------------
VITE_API_URL=http://localhost:3000
