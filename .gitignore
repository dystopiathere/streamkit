# Сгенерированный клиент Prisma и локальные окружения приложений
apps/*/.env
# Файлы окружения, которые deploy.sh собирает на ВМ: в них пароли баз.
infra/yandex-cloud/app/*.env

# Terraform: рабочие файлы, состояние и локальные настройки с идентификаторами.
# .terraform.lock.hcl коммитится — он фиксирует версии провайдеров.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
backend.hcl
# Сохранённый план содержит значения переменных и сгенерированные секреты.
*.tfplan
# Ключи сервисных аккаунтов, выпущенные рядом с Terraform (ключ публикации
# образов для GitHub и т. п.): закрытый ключ, по которому облако выдаёт токены.
*key*.json
