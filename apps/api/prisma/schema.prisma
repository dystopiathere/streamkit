// StreamKit — схема данных.
//
// Инварианты, которые Prisma не выражает, но которые обязаны соблюдать сервисы:
//  * Деньги хранятся только парой (amountMinor, currency) и только целыми минорными
//    единицами. Либо оба поля заполнены, либо оба NULL.
//  * Ничего секретного не лежит в открытом виде: токены и TOTP-секреты шифруются
//    AES-256-GCM (см. src/common/crypto), в БД попадает только шифротекст.
//  * Токены (refresh, overlay) хранятся хэшем. Оригинал существует только у клиента.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* Пользователи и аутентификация                                        */
/* ------------------------------------------------------------------ */

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Пользователь запросил удаление: ПДн обезличены, запись оставлена ради
  /// ссылочной целостности истории событий.
  ANONYMIZED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String
  displayName         String
  status              UserStatus @default(ACTIVE)
  isTotpEnabled       Boolean    @default(false)
  /// Шифротекст TOTP-секрета. NULL, пока второй фактор не подключён.
  totpSecretEncrypted String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  anonymizedAt        DateTime?

  refreshTokens   RefreshToken[]
  consents        Consent[]
  widgets         Widget[]
  alertEvents     AlertEvent[]
  donationSources DonationSource[]
  credentials     IntegrationCredential[]
  channels        Channel[]
  auditLogs       AuditLog[]

  @@index([status])
}

/// Refresh-токен с ротацией. Семейство (familyId) заводится при логине; каждое
/// обновление создаёт новый токен и помечает старый использованным. Предъявление
/// уже использованного токена означает кражу — гасим всё семейство.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  /// sha256 от секрета. Сам секрет в БД не попадает.
  tokenHash    String    @unique
  userAgent    String?
  /// Хэш IP, а не IP: для разбора инцидентов хватает, объём ПДн меньше.
  ipHash       String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  /// Проставляется при ротации или отзыве. Непустое значение = токен больше не валиден.
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/* ------------------------------------------------------------------ */
/* Согласия и аудит (152-ФЗ)                                            */
/* ------------------------------------------------------------------ */

enum ConsentDocument {
  TERMS
  PRIVACY
  PERSONAL_DATA
  COOKIE_ANALYTICS
  MARKETING
}

/// Журнал согласий. Хранится версия документа, действовавшая в момент согласия:
/// без неё невозможно доказать, на что именно согласился пользователь.
model Consent {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  document        ConsentDocument
  documentVersion String
  grantedAt       DateTime        @default(now())
  revokedAt       DateTime?
  ipHash          String?
  userAgent       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document])
}

/// Аудит значимых действий: входы, смена пароля, отзыв токенов, экспорт и удаление
/// данных, неудачные проверки подписи вебхука.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ipHash    String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/* ------------------------------------------------------------------ */
/* Виджеты и overlay                                                    */
/* ------------------------------------------------------------------ */

enum WidgetType {
  ALERTS
  GOAL
  TIMER
  TOP_DONORS
}

model Widget {
  id       String     @id @default(uuid()) @db.Uuid
  userId   String     @db.Uuid
  type     WidgetType
  name     String
  isEnabled Boolean   @default(true)
  /// Конфиг, провалидированный схемой из @streamkit/contracts.
  config   Json
  /// Версия формы конфига. Ломающее изменение схемы = инкремент + миграция данных.
  configVersion Int   @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens OverlayToken[]
  state  WidgetState?

  @@index([userId])
}

/// Изменяемое состояние виджета: стартовая сумма цели, момент окончания таймера.
///
/// Отдельно от config, потому что это разные вещи по происхождению: config
/// настраивает стример, state меняет сама работа виджета. Смешать их значило бы
/// переписывать пользовательские настройки при каждом тике таймера.
///
/// В БД, а не в Redis: Redis здесь держит только производное и временное
/// (дедупликация, счётчики квоты, блокировки), и его потеря не должна ничего
/// стоить. Сброшенный посреди марафона таймер восстановить неоткуда.
model WidgetState {
  widgetId  String   @id @db.Uuid
  /// Провалидировано схемой типа виджета из @streamkit/contracts.
  state     Json
  updatedAt DateTime @updatedAt

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

/// Публичная ссылка на виджет для браузер-сорса OBS. В БД только хэш токена,
/// поэтому утечка дампа не даёт доступа к чужим оверлеям.
model OverlayToken {
  id        String    @id @default(uuid()) @db.Uuid
  widgetId  String    @db.Uuid
  tokenHash String    @unique
  label     String?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt DateTime?

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId])
}

/* ------------------------------------------------------------------ */
/* События и источники                                                  */
/* ------------------------------------------------------------------ */

enum EventProvider {
  DONATIONALERTS
  DONATEPAY
  TWITCH
  YOUTUBE
  WEBHOOK
  MANUAL
}

enum AlertEventType {
  DONATION
  FOLLOW
  SUBSCRIPTION
  RESUBSCRIPTION
  CHEER
  RAID
  REWARD
}

/// Нормализованное событие. Уникальность (provider, externalId, userId) — вторая
/// линия защиты от дублей после быстрой проверки в Redis: если Redis потерял ключ
/// при рестарте, БД всё равно не даст записать событие дважды.
model AlertEvent {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  type        AlertEventType
  provider    EventProvider
  externalId  String
  username    String
  message     String         @db.VarChar(500)
  amountMinor Int?
  currency    String?        @db.VarChar(3)
  isTest      Boolean        @default(false)
  occurredAt  DateTime
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, userId])
  @@index([userId, createdAt])
}

/// Подключённый источник донат-событий.
model DonationSource {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          EventProvider
  isEnabled         Boolean       @default(true)
  /// Идентификатор аккаунта на стороне провайдера (для диагностики и отображения).
  externalAccountId String?
  /// Секрет для проверки HMAC собственного вебхука. Шифротекст.
  webhookSecretEncrypted String?
  /// Почему источник выключен, если выключен не пользователем. NULL — либо
  /// работает, либо выключен вручную. Без этого поля истёкший доступ выглядел
  /// в данных ровно как осознанное решение стримера.
  disabledReason    String?
  lastEventAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/* ------------------------------------------------------------------ */
/* Интеграции с площадками                                              */
/* ------------------------------------------------------------------ */

enum Platform {
  TWITCH
  YOUTUBE
  VKPLAY
  TROVO
}

/// Состояние сбора метрик. Отдельное поле, а не «последняя ошибка строкой»:
/// «переподключите площадку» и «квота исчерпана» — разные действия пользователя.
enum ChannelSyncState {
  OK
  /// Площадка отвергла токен: нужен повторный вход. Опрос прекращается.
  AUTH_EXPIRED
  /// Суточная квота внешнего API исчерпана. Опрос возобновится сам.
  RATE_LIMITED
  ERROR
}

model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  platform    Platform
  externalId  String
  login       String
  displayName String
  avatarUrl   String?
  isEnabled   Boolean  @default(true)
  /// Когда метрики собирались в последний раз. NULL — ещё ни разу.
  lastSyncedAt DateTime?
  syncState   ChannelSyncState @default(OK)
  /// Текст последней ошибки — только для диагностики, наружу не отдаётся.
  syncError   String?
  /// Сколько неудач подряд. Обнуляется первым же удачным сбором.
  syncAttempts Int     @default(0)
  /// Не опрашивать раньше этого момента. Отдельно от lastSyncedAt: «когда
  /// удалось собрать» и «когда пробовать снова» расходятся ровно тогда, когда
  /// собирать перестало получаться. Раньше каденция считалась по lastSyncedAt,
  /// и сбойный канал повторялся каждую минуту вместо положенных пятнадцати,
  /// занимая место в выборке и вытесняя из неё исправные.
  nextAttemptAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots AnalyticsSnapshot[]

  /// Один канал на площадку у пользователя. Уникальность НЕ глобальная по
  /// (platform, externalId): глобальная навсегда запирала бы канал за удалённым
  /// аккаунтом и запрещала двум менеджерам одного канала подключить его каждому
  /// к своему дашборду. Аналитика канала — не владение каналом.
  @@unique([userId, platform])
  @@index([platform, externalId])
  @@index([userId])
}

/// Снимок метрик канала.
///
/// Хранятся сырые снимки, а не предагрегаты: диапазоны в интерфейсе будут
/// меняться, и пересчитать агрегат из снимков можно, а восстановить снимки из
/// агрегата — нет. Прореживание до читаемого числа точек делает запрос.
model AnalyticsSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  channelId   String   @db.Uuid
  capturedAt  DateTime
  isLive      Boolean
  /// Зрители в момент снимка. NULL, когда эфира нет — не ноль: ноль означал бы
  /// «шёл эфир, и никто не смотрел», а это другое утверждение.
  viewers     Int?
  followers   Int?
  subscribers Int?
  /// Суммарные просмотры канала. BigInt: у крупного канала они не влезают в Int32.
  totalViews  BigInt?
  title       String?  @db.VarChar(200)
  category    String?  @db.VarChar(120)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Защита от двойной записи, если тик опроса выполнится дважды.
  @@unique([channelId, capturedAt])
  @@index([channelId, capturedAt])
}

/// OAuth-токены пользователя к внешним сервисам. Только шифротекст; наружу не
/// отдаются никогда, даже владельцу.
model IntegrationCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  provider              String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scopes                String[]
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([expiresAt])
}
