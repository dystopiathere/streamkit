// StreamKit — схема данных.
//
// Инварианты, которые Prisma не выражает, но которые обязаны соблюдать сервисы:
//  * Деньги хранятся только парой (amountMinor, currency) и только целыми минорными
//    единицами. Либо оба поля заполнены, либо оба NULL.
//  * Ничего секретного не лежит в открытом виде: токены и TOTP-секреты шифруются
//    AES-256-GCM (см. src/common/crypto), в БД попадает только шифротекст.
//  * Токены (refresh, overlay) хранятся хэшем. Оригинал существует только у клиента.

generator client {
  provider = "prisma-client-js"
}

// Адрес БД в схеме больше не живёт: Prisma 7 забрал его отсюда, потому что
// один и тот же файл читают и CLI, и клиент, а подключаются они по-разному.
// Для CLI адрес задаётся в prisma.config.ts, для клиента — драйвер-адаптером
// в PrismaService.
datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Пользователи и аутентификация
 */
/**
 * ------------------------------------------------------------------
 */

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Пользователь запросил удаление: ПДн обезличены, запись оставлена ради
  /// ссылочной целостности истории событий.
  ANONYMIZED
}

/// Роль сотрудника платформы. Стример — USER; SUPPORT и ADMIN входят в
/// админку, и только с включённой TOTP.
enum UserRole {
  USER
  /// Видит данные и отзывает ссылки и сессии.
  SUPPORT
  /// Вдобавок блокирует и обезличивает аккаунты, выдаёт роли, меняет подписки.
  ADMIN
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String
  displayName         String
  status              UserStatus @default(ACTIVE)
  role                UserRole   @default(USER)
  isTotpEnabled       Boolean    @default(false)
  /// Шифротекст TOTP-секрета. NULL, пока второй фактор не подключён.
  totpSecretEncrypted String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  anonymizedAt        DateTime?

  refreshTokens   RefreshToken[]
  consents        Consent[]
  widgets         Widget[]
  alertEvents     AlertEvent[]
  donationSources DonationSource[]
  credentials     IntegrationCredential[]
  channels        Channel[]
  rooms           Room[]
  subscription    Subscription?
  payments        Payment[]
  auditLogs       AuditLog[]
  /// Действия сотрудника над чужими аккаунтами.
  actedAuditLogs  AuditLog[]              @relation("AuditActor")

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

/// Где действует сессия. Админская сессия — отдельное семейство со своей
/// cookie: утёкший токен дашборда не открывает админку, и наоборот.
enum SessionScope {
  USER
  ADMIN
}

/// Refresh-токен с ротацией. Семейство (familyId) заводится при логине; каждое
/// обновление создаёт новый токен и помечает старый использованным. Предъявление
/// уже использованного токена означает кражу — гасим всё семейство.
model RefreshToken {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  familyId     String       @db.Uuid
  /// sha256 от секрета. Сам секрет в БД не попадает.
  tokenHash    String       @unique
  userAgent    String?
  /// Хэш IP, а не IP: для разбора инцидентов хватает, объём ПДн меньше.
  ipHash       String?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  lastUsedAt   DateTime     @default(now())
  /// Проставляется при ротации или отзыве. Непустое значение = токен больше не валиден.
  revokedAt    DateTime?
  replacedById String?      @db.Uuid
  scope        SessionScope @default(USER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Активные пользователи за период — по последнему обновлению сессии.
  @@index([lastUsedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Согласия и аудит (152-ФЗ)
 */
/**
 * ------------------------------------------------------------------
 */

enum ConsentDocument {
  TERMS
  PRIVACY
  PERSONAL_DATA
  COOKIE_ANALYTICS
  MARKETING
  /// Оферта тарифа и согласие на автоматические списания. Даётся только при
  /// оплате; отзыв выключает автопродление.
  SUBSCRIPTION_OFFER
}

/// Журнал согласий. Хранится версия документа, действовавшая в момент согласия:
/// без неё невозможно доказать, на что именно согласился пользователь.
model Consent {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  document        ConsentDocument
  documentVersion String
  grantedAt       DateTime        @default(now())
  revokedAt       DateTime?
  ipHash          String?
  userAgent       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document])
}

/// Аудит значимых действий: входы, смена пароля, отзыв токенов, экспорт и удаление
/// данных, неудачные проверки подписи вебхука.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// Чей аккаунт или объект затронут.
  userId    String?  @db.Uuid
  /// Кто действовал, если не сам владелец: сотрудник из админки.
  actorId   String?  @db.Uuid
  action    String
  ipHash    String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  /// Уборка по сроку хранения удаляет по одному createdAt: составные индексы
  /// выше ей не помогают, и каждый ночной проход читал таблицу целиком.
  @@index([createdAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Виджеты и overlay
 */
/**
 * ------------------------------------------------------------------
 */

enum WidgetType {
  ALERTS
  GOAL
  TIMER
  TOP_DONORS
  CHAT
  GUESTS
}

model Widget {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  type          WidgetType
  name          String
  isEnabled     Boolean    @default(true)
  /// Конфиг, провалидированный схемой из @streamkit/contracts.
  config        Json
  /// Версия формы конфига. Ломающее изменение схемы = инкремент + миграция данных.
  configVersion Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens OverlayToken[]
  state  WidgetState?

  @@index([userId])
}

/// Изменяемое состояние виджета: стартовая сумма цели, момент окончания таймера.
///
/// Отдельно от config, потому что это разные вещи по происхождению: config
/// настраивает стример, state меняет сама работа виджета. Смешать их значило бы
/// переписывать пользовательские настройки при каждом тике таймера.
///
/// В БД, а не в Redis: Redis здесь держит только производное и временное
/// (дедупликация, счётчики квоты, блокировки), и его потеря не должна ничего
/// стоить. Сброшенный посреди марафона таймер восстановить неоткуда.
model WidgetState {
  widgetId  String   @id @db.Uuid
  /// Провалидировано схемой типа виджета из @streamkit/contracts.
  state     Json
  updatedAt DateTime @updatedAt

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

/// Публичная ссылка на виджет для браузер-сорса OBS. В БД только хэш токена,
/// поэтому утечка дампа не даёт доступа к чужим оверлеям.
model OverlayToken {
  id         String    @id @default(uuid()) @db.Uuid
  widgetId   String    @db.Uuid
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId])
}

/// Приватная комната стримера. Медиа живёт в LiveKit, здесь — только владение и
/// приглашения. Комната LiveKit называется по id и создаётся при первом входе.
model Room {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invites RoomInvite[]

  @@index([userId])
}

/// Ссылка-приглашение на одного гостя. Форма та же, что у OverlayToken: в БД
/// только хэш, сам токен виден один раз при выпуске.
model RoomInvite {
  id           String    @id @default(uuid()) @db.Uuid
  roomId       String    @db.Uuid
  tokenHash    String    @unique
  label        String    @db.VarChar(80)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  /// Стример выключил гостю микрофон. На приглашении, а не на участнике: иначе
  /// гость снимал бы запрет перезагрузкой вкладки.
  micBlockedAt DateTime?

  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  consents GuestConsent[]

  @@index([roomId])
}

/// Согласие гостя на передачу имени, изображения и голоса.
///
/// Отдельно от Consent, потому что у гостя нет учётной записи, а Consent к ней
/// привязан. Имени гостя здесь НЕТ: оно живёт только в токене LiveKit, и
/// хранить его ради доказательства согласия не нужно — хватает ссылки,
/// редакции документа, времени и отпечатка запроса.
model GuestConsent {
  id              String   @id @default(uuid()) @db.Uuid
  inviteId        String   @db.Uuid
  documentVersion String
  grantedAt       DateTime @default(now())
  ipHash          String?
  userAgent       String?  @db.VarChar(512)

  invite RoomInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@index([grantedAt])
}

/// Согласие анонимного посетителя публичных страниц на статистику посещений.
///
/// Отдельно от Consent по той же причине, что и GuestConsent: учётной записи
/// нет. visitorId — случайный идентификатор, выпущенный браузером; он не
/// связан ни с аккаунтом, ни с записями статистики в Umami.
model VisitorConsent {
  id              String    @id @default(uuid()) @db.Uuid
  visitorId       String    @db.Uuid
  documentVersion String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  ipHash          String?
  userAgent       String?   @db.VarChar(512)

  @@index([visitorId])
  @@index([grantedAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * События и источники
 */
/**
 * ------------------------------------------------------------------
 */

enum EventProvider {
  DONATIONALERTS
  DONATEPAY
  TWITCH
  YOUTUBE
  WEBHOOK
  MANUAL
}

enum AlertEventType {
  DONATION
  FOLLOW
  SUBSCRIPTION
  RESUBSCRIPTION
  CHEER
  RAID
  REWARD
}

/// Нормализованное событие. Уникальность (provider, externalId, userId) — вторая
/// линия защиты от дублей после быстрой проверки в Redis: если Redis потерял ключ
/// при рестарте, БД всё равно не даст записать событие дважды.
model AlertEvent {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  type        AlertEventType
  provider    EventProvider
  externalId  String
  username    String
  message     String         @db.VarChar(500)
  amountMinor Int?
  currency    String?        @db.VarChar(3)
  isTest      Boolean        @default(false)
  occurredAt  DateTime
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, userId])
  @@index([userId, createdAt])
  /// Сводка по платформе в админке считает события за период по всем аккаунтам.
  @@index([createdAt])
}

/// Подключённый источник донат-событий.
model DonationSource {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @db.Uuid
  provider               EventProvider
  isEnabled              Boolean       @default(true)
  /// Идентификатор аккаунта на стороне провайдера (для диагностики и отображения).
  externalAccountId      String?
  /// Имя аккаунта у провайдера — стример видит, какой аккаунт подключён.
  /// Почта аккаунта не хранится, хотя DonationAlerts отдаёт её в профиле.
  accountName            String?
  /// Секрет для проверки HMAC собственного вебхука. Шифротекст.
  webhookSecretEncrypted String?
  /// Почему источник выключен, если выключен не пользователем. NULL — либо
  /// работает, либо выключен вручную. Без этого поля истёкший доступ выглядел
  /// в данных ровно как осознанное решение стримера.
  disabledReason         String?
  lastEventAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Интеграции с площадками
 */
/**
 * ------------------------------------------------------------------
 */

enum Platform {
  TWITCH
  YOUTUBE
  VKPLAY
  TROVO
}

/// Состояние сбора метрик. Отдельное поле, а не «последняя ошибка строкой»:
/// «переподключите площадку» и «квота исчерпана» — разные действия пользователя.
enum ChannelSyncState {
  OK
  /// Площадка отвергла токен: нужен повторный вход. Опрос прекращается.
  AUTH_EXPIRED
  /// Суточная квота внешнего API исчерпана. Опрос возобновится сам.
  RATE_LIMITED
  ERROR
}

model Channel {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  platform      Platform
  externalId    String
  login         String
  displayName   String
  avatarUrl     String?
  isEnabled     Boolean          @default(true)
  /// Когда метрики собирались в последний раз. NULL — ещё ни разу.
  lastSyncedAt  DateTime?
  /// Начало идущего эфира по часам площадки; null вне эфира. Только текущее
  /// значение: для истории хватает isLive в снимках.
  liveSince     DateTime?
  syncState     ChannelSyncState @default(OK)
  /// Текст последней ошибки — только для диагностики, наружу не отдаётся.
  syncError     String?
  /// Сколько неудач подряд. Обнуляется первым же удачным сбором.
  syncAttempts  Int              @default(0)
  /// Не опрашивать раньше этого момента. Отдельно от lastSyncedAt: «когда
  /// удалось собрать» и «когда пробовать снова» расходятся ровно тогда, когда
  /// собирать перестало получаться. Раньше каденция считалась по lastSyncedAt,
  /// и сбойный канал повторялся каждую минуту вместо положенных пятнадцати,
  /// занимая место в выборке и вытесняя из неё исправные.
  nextAttemptAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots AnalyticsSnapshot[]

  /// Один канал на площадку у пользователя. Уникальность НЕ глобальная по
  /// (platform, externalId): глобальная навсегда запирала бы канал за удалённым
  /// аккаунтом и запрещала двум менеджерам одного канала подключить его каждому
  /// к своему дашборду. Аналитика канала — не владение каналом.
  @@unique([userId, platform])
  @@index([platform, externalId])
  @@index([userId])
}

/// Снимок метрик канала.
///
/// Хранятся сырые снимки, а не предагрегаты: диапазоны в интерфейсе будут
/// меняться, и пересчитать агрегат из снимков можно, а восстановить снимки из
/// агрегата — нет. Прореживание до читаемого числа точек делает запрос.
model AnalyticsSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  channelId   String   @db.Uuid
  capturedAt  DateTime
  isLive      Boolean
  /// Зрители в момент снимка. NULL, когда эфира нет — не ноль: ноль означал бы
  /// «шёл эфир, и никто не смотрел», а это другое утверждение.
  viewers     Int?
  followers   Int?
  subscribers Int?
  /// Суммарные просмотры канала. BigInt: у крупного канала они не влезают в Int32.
  totalViews  BigInt?
  title       String?  @db.VarChar(200)
  category    String?  @db.VarChar(120)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Защита от двойной записи, если тик опроса выполнится дважды. Уникальный
  /// индекс заодно обслуживает выборку ряда канала — отдельный индекс на те же
  /// колонки только удваивал стоимость записи снимка раз в минуту.
  @@unique([channelId, capturedAt])
  /// Уборка по сроку хранения — по одному capturedAt, без канала.
  @@index([capturedAt])
}

/// OAuth-токены пользователя к внешним сервисам. Только шифротекст; наружу не
/// отдаются никогда, даже владельцу.
model IntegrationCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  provider              String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scopes                String[]
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([expiresAt])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Подписка на платформу (docs/adr/0011)
 */
/**
 * --------------------------------------------------------------------------
 */

enum BillingPeriod {
  MONTH
  YEAR
}

/// Подписка стримера на тариф «Про». Одна на пользователя: история — в Payment.
///
/// Статус не хранится, а вычисляется из конца периода и автопродления: хранимый
/// статус пришлось бы переключать задачей по расписанию ровно в полночь, и
/// между концом периода и тактом задачи доступ был бы то открыт, то закрыт.
model Subscription {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @unique @db.Uuid
  /// Период СЛЕДУЮЩЕГО продления: смена месяца на год применяется при нём.
  period                 BillingPeriod
  currentPeriodEnd       DateTime?
  autoRenew              Boolean       @default(false)
  /// Шифротекст идентификатора сохранённого способа оплаты ЮKassa. По нему
  /// списываются деньги без участия стримера — это секрет, как токен площадки.
  paymentMethodEncrypted String?
  /// «Карта *4444» — только для интерфейса.
  paymentMethodTitle     String?       @db.VarChar(120)
  /// Цена продления — снимок на момент оформления или смены периода, а не
  /// текущий прайс. Оферта обещает предупредить о новой цене за 30 дней, и
  /// поправленная в коде константа не должна молча списаться с действующих
  /// подписчиков при следующей выкатке.
  renewalAmountMinor     Int
  renewalCurrency        String        @db.VarChar(3)
  renewalFailures        Int           @default(0)
  nextRenewalAttemptAt   DateTime?
  /// Письмо о предстоящем списании: за какой конец периода и когда ушло.
  /// Продление без него не списывается — оферта обещает предупредить за три дня.
  renewalNoticeFor       DateTime?
  renewalNoticeSentAt    DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([autoRenew, currentPeriodEnd])
}

enum PaymentKind {
  INITIAL
  RENEWAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

/// Платёж за период. Сумма — снимок цены на момент создания: списание берёт её
/// отсюда, а не из текущего прайса.
///
/// Удаление пользователя платежи не стирает (Restrict): это учёт выручки, а
/// аккаунты у нас не удаляются, а обезличиваются.
model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  subscriptionId      String?       @db.Uuid
  kind                PaymentKind
  period              BillingPeriod
  amountMinor         Int
  currency            String        @db.VarChar(3)
  status              PaymentStatus @default(PENDING)
  /// Идентификатор платежа в ЮKassa. NULL, пока запрос на создание не прошёл.
  providerPaymentId   String?       @unique
  cancellationReason  String?       @db.VarChar(80)
  /// За какой конец периода это продление. Вместе с attempt не даёт двум
  /// репликам воркера списать одно и то же продление дважды.
  renewalFor          DateTime?
  attempt             Int           @default(1)
  periodStart         DateTime?
  periodEnd           DateTime?
  /// Сколько возвращено по платежу — сумма успешных возвратов в ЮKassa,
  /// пересчитанная целиком при каждом уведомлении, а не накопленная: повтор
  /// уведомления не должен удваивать возврат.
  refundedAmountMinor Int           @default(0)
  refundedAt          DateTime?
  createdAt           DateTime      @default(now())
  paidAt              DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, renewalFor, attempt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
