{
  "name": "streamkit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @streamkit/api exec prisma generate",
    "db:migrate": "pnpm --filter @streamkit/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @streamkit/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @streamkit/api run db:seed",
    "docker:dev": "docker compose -f infra/docker/compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f infra/docker/compose.dev.yml down -v",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
